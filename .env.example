SITE_NAME="Bal Coffee"

# --- Legacy hand-rolled Storefront layer (still in use until the commerce
# adapter migration completes; see HYDROGEN_MIGRATION.md) ---
SHOPIFY_STORE_DOMAIN="bal-coffee.myshopify.com"
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STOREFRONT_API_VERSION="2025-10"
SHOPIFY_WEBHOOK_SECRET=""

# In-person event drink ordering (/event and /event/board).
# All of these are server-only. Never prefix them with NEXT_PUBLIC_.
# EVENT_BOARD_PASSCODE unlocks the team board.
# Twilio sends the ready text. Leave blank until the number is registered
# (US long codes need A2P 10DLC, or use a verified toll-free number).
# Storage is Upstash Redis from the Vercel Marketplace (not provisioned here).
# KV_REST_API_URL / KV_REST_API_TOKEN are accepted as a legacy Vercel KV alias.
EVENT_BOARD_PASSCODE=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Hydrogen toolkit (@shopify/hydrogen) expected env vars ---
# Map from the legacy pair above: PUBLIC_STORE_DOMAIN = SHOPIFY_STORE_DOMAIN,
# PRIVATE_STOREFRONT_API_TOKEN = SHOPIFY_STOREFRONT_ACCESS_TOKEN.
# Must also be set in Vercel project settings before the adapter goes live.
PUBLIC_STORE_DOMAIN="bal-coffee.myshopify.com"
PRIVATE_STOREFRONT_API_TOKEN=""

# Google Analytics 4 measurement id (public). Leave unset to disable the tag
# and ecommerce events. Set the real id in Vercel after creating the property.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
